# Heap environment (app) ID used by default on every call.
# Find it in Heap under Account > Manage > Projects.
HEAP_APP_ID=

# API key, required ONLY for the user-deletion tools.
# Admins generate this in Heap under Account > Manage > Privacy & Security.
# For deletion, HEAP_APP_ID must be your Main Production environment ID.
HEAP_API_KEY=

# Datacenter: "us" (default) or "eu".
HEAP_DATA_CENTER=us

# Optional: override the Heap host (e.g. a proxy/gateway in front of Heap).
# When set, it applies to both ingestion and deletion endpoints.
# HEAP_BASE_URL=https://my-heap-proxy.example.com

# Transport: "stdio" (default) or "http".
TRANSPORT=stdio

# Port for the http transport.
PORT=3000

# --- Data vault sources (Heap Connect warehouses) --------------------------
# Named sources live in a JSON file; run the setup_data prompt (in Claude
# Code: /mcp__heap__setup_data) or the heap_add_source tool to create it.
# Override the file location (default ~/.heap-mcp/sources.json):
# HEAP_SOURCES_PATH=/path/to/sources.json

# Force-enable/disable heap_add_source & heap_remove_source.
# Default: enabled on stdio, disabled on the unauthenticated http transport.
# HEAP_ALLOW_SOURCE_ADMIN=true

# Secrets referenced from the sources file as ${VAR} are resolved from the
# environment at connect time, e.g. "password": "${HEAP_SF_PASSWORD}" plus:
# HEAP_SF_PASSWORD=

# Legacy single-warehouse config (still supported; loads as source "default"):
# HEAP_WAREHOUSE=bigquery|snowflake|redshift
# HEAP_BQ_PROJECT=  HEAP_BQ_DATASET=heap  HEAP_BQ_CREDENTIALS=
# HEAP_SF_ACCOUNT=  HEAP_SF_USERNAME=  HEAP_SF_PASSWORD=
# HEAP_SF_DATABASE=  HEAP_SF_SCHEMA=heap  HEAP_SF_WAREHOUSE=
# HEAP_RS_HOST=  HEAP_RS_PORT=5439  HEAP_RS_DATABASE=
# HEAP_RS_SCHEMA=heap  HEAP_RS_USER=  HEAP_RS_PASSWORD=
